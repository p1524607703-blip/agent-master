generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./alexa-auditor.db"
}

model ProductSnapshot {
  id              String          @id @default(cuid())
  asin            String
  requestedAsin   String?
  resolvedAsin    String?
  asinAliasesJson String          @default("[]")
  title           String
  brand           String
  accountLabel    String
  selectorVersion String
  schemaVersion   String
  snapshotJson    String
  capturedAt      DateTime
  createdAt       DateTime        @default(now())
  runs            ExperimentRun[]

  @@index([asin, capturedAt])
  @@index([resolvedAsin, capturedAt])
}

model ExperimentRun {
  id                       String             @id @default(cuid())
  productSnapshotId        String
  status                   String
  accountLabel             String
  runSeed                  String
  preset                   String             @default("calibration")
  promptLanguage           String             @default("en-US")
  sessionPolicy            String             @default("fresh")
  promptVersion            String             @default("footwear-v4.1.0")
  questionPlanRevision     Int                @default(1)
  questionPlanEditable     Boolean            @default(true)
  questionPlanApprovedAt   DateTime?
  questionPlanLockedAt     DateTime?
  judgmentStandardsVersion String             @default("footwear-judgment-v1")
  promptCount              Int
  repetitions              Int
  totalTurns               Int
  completedTurns           Int                @default(0)
  scoreJson                String?
  diagnosisJson            String?
  stopReason               String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  productSnapshot          ProductSnapshot    @relation(fields: [productSnapshotId], references: [id], onDelete: Cascade)
  promptCases              PromptCase[]
  turns                    ConversationTurn[]
  events                   RunEvent[]

  @@index([productSnapshotId, createdAt])
}

model PromptCase {
  id                   String            @id
  runId                String
  templateId           String            @default("legacy")
  enabled              Boolean           @default(true)
  slot                 String
  mode                 String
  expression           String
  promptText           String
  testRole             String            @default("baseline")
  scoreEligible        Boolean           @default(false)
  hypothesis           String            @default("")
  expectedMatch        String            @default("neutral")
  evidenceFactIdsJson  String            @default("[]")
  requiredTermsJson    String            @default("[]")
  judgmentCriteriaJson String            @default("[]")
  promptVersion        String            @default("footwear-v4.1.0")
  sessionPolicy        String            @default("fresh")
  sessionGroup         String?
  generatedBy          String            @default("deterministic")
  originalPromptText   String?
  rewriteReason        String?
  repeatIndex          Int
  sequence             Int
  status               String            @default("pending")
  revision             Int               @default(1)
  editable             Boolean           @default(true)
  updatedAt            DateTime          @updatedAt
  run                  ExperimentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  turn                 ConversationTurn?

  @@unique([runId, sequence])
  @@index([runId, status])
  @@index([runId, enabled, status])
  @@index([runId, testRole, scoreEligible])
}

model ConversationTurn {
  id                  String        @id @default(cuid())
  runId               String
  promptCaseId        String        @unique
  promptText          String
  responseText        String
  recommendationsJson String
  judgmentJson        String?
  judgmentVersion     String?
  screenshotPath      String?
  selectorVersion     String
  status              String
  errorCode           String?
  errorMessage        String?
  capturedAt          DateTime
  createdAt           DateTime      @default(now())
  run                 ExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptCase          PromptCase    @relation(fields: [promptCaseId], references: [id], onDelete: Cascade)

  @@index([runId, capturedAt])
}

model RunEvent {
  id           String        @id @default(cuid())
  runId        String
  type         String
  actor        String        @default("system")
  promptCaseId String?
  payloadJson  String
  createdAt    DateTime      @default(now())
  run          ExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([runId, type, createdAt])
  @@index([promptCaseId, createdAt])
}
