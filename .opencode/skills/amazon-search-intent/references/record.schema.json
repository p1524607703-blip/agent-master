{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amazon-search-intent-record-v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_term", "normalized_term", "term_id", "query_kind", "language",
    "primary_domain", "secondary_domain", "product_type", "audience_intent",
    "function_intent", "capability_intent", "event_intent", "location_intent",
    "body_need_intent", "time_intent", "substitute_intent", "complement_intent",
    "latent_task", "intent_stage", "evidence_type", "confidence_level",
    "intent_cluster", "routing_action", "field_evidence", "ambiguity_flags",
    "asin_fit", "asin_fit_evidence", "review_status", "schema_version",
    "prompt_version", "model_name", "run_id"
  ],
  "properties": {
    "source_term": {"type": "string"},
    "normalized_term": {"type": "string"},
    "term_id": {"type": "string", "pattern": "^[a-f0-9]{16}$|^blank$"},
    "query_kind": {"enum": ["keyword", "asin_target", "blank"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}([_-][a-z]{2})?$|^mixed$|^unknown$"},
    "primary_domain": {"enum": ["clothing_shoes_jewelry", "sports_outdoors", "home_kitchen", "patio_lawn_garden", "tools_home_improvement", "musical_instruments", "industrial_scientific", "automotive", "electronics", "baby_products", "arts_crafts_sewing", "health_household", "toys_games", "video_games", "grocery_gourmet_food", "office_products", "pet_supplies", "others"]},
    "secondary_domain": {"type": "array", "items": {"type": "string"}},
    "product_type": {"type": "array", "items": {"type": "string"}},
    "audience_intent": {"type": "array", "items": {"type": "string"}},
    "function_intent": {"type": "array", "items": {"type": "string"}},
    "capability_intent": {"type": "array", "items": {"type": "string"}},
    "event_intent": {"type": "array", "items": {"type": "string"}},
    "location_intent": {"type": "array", "items": {"type": "string"}},
    "body_need_intent": {"type": "array", "items": {"type": "string"}},
    "time_intent": {"type": "array", "items": {"type": "string"}},
    "substitute_intent": {"type": "array", "items": {"type": "string"}},
    "complement_intent": {"type": "array", "items": {"type": "string"}},
    "latent_task": {"type": "string"},
    "intent_stage": {"enum": ["exploration", "consideration", "high_intent", "brand_harvest", "unknown"]},
    "evidence_type": {"type": "array", "items": {"enum": ["explicit", "page_validated", "inferred"]}, "uniqueItems": true},
    "confidence_level": {"enum": ["high", "medium", "low"]},
    "intent_cluster": {"type": "string", "pattern": "^[a-z0-9_]+$|^unclassified$"},
    "routing_action": {"enum": ["cluster_route", "listing_gap_review", "ambiguity_review", "semantic_negative_candidate", "performance_observation", "asin_metadata_pending", "blank_skip"]},
    "field_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_type", "source_span", "fact_ids", "rationale"],
          "properties": {
            "value": {"type": "string"},
            "evidence_type": {"enum": ["explicit", "page_validated", "inferred"]},
            "source_span": {"type": "string"},
            "fact_ids": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string"}
          }
        }
      }
    },
    "ambiguity_flags": {"type": "array", "items": {"type": "string"}},
    "asin_fit": {"enum": ["match", "partial_match", "mismatch", "unknown", "not_applicable"]},
    "asin_fit_evidence": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["accepted", "needs_review", "critic_flagged", "non_model"]},
    "schema_version": {"const": "1.0.0"},
    "prompt_version": {"const": "1.0.0"},
    "model_name": {"const": "deepseek/deepseek-v4-pro"},
    "run_id": {"type": "string", "minLength": 8}
  }
}

